{
	"name": "discord-developer",
	"version": "1.0.0",
	"description": "A reusable Discord onboarding bot, configurable per-server with /config slash commands",
	"keywords": [],
	"license": "ISC",
	"author": "",
	"type": "module",
	"main": "index.js",
	"scripts": {
		"build": "tsc && cp src/db/schema.sql dist/db/schema.sql",
		"dev": "tsx watch src/index.ts",
		"format": "prettier --write .",
		"start": "node dist/index.js",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
	},
	"dependencies": {
		"better-sqlite3": "^13.0.3",
		"discord.js": "^14.27.0",
		"dotenv": "^17.4.2"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.2.0",
		"prettier": "^3.9.6",
		"prettier-plugin-packagejson": "^3.0.2",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"packageManager": "pnpm@10.30.1",
	"engines": {
		"node": ">=20"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"better-sqlite3",
			"esbuild"
		]
	}
}
